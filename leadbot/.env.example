# LLM Configuration
# Option 1: Ollama (free, local) - leave LLM_API_KEY empty
LLM_PROVIDER=ollama/minimax-m3:cloud
LLM_API_KEY=

# Option 2: Groq (free 6000 req/day) - uncomment and set key
# LLM_PROVIDER=groq/llama-3.3-70b-versatile
# LLM_API_KEY=gsk_your_groq_key_here

# Crawl politeness (seconds between requests)
CRAWL_DELAY_MIN=3
CRAWL_DELAY_MAX=8

# Target niches (comma-separated)
TARGET_NICHES=web design agency,digital marketing agency,SaaS startup,IT consulting

# Target locations (comma-separated)
TARGET_LOCATIONS=United Kingdom,United States,Australia,UAE

# Max leads per source per run
MAX_LEADS_PER_SOURCE=100

# ----- NOTIFICATIONS (optional) -----
# Add one or more of these to get notified when new high-score leads arrive

# Discord webhook: Server Settings -> Integrations -> Webhooks -> New Webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456/abcdef...

# Telegram: Create a bot via @BotFather, get chat_id via @userinfobot
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# Slack: Apps -> Incoming Webhooks -> Add to Slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXX

# Generic webhook (Make.com, n8n, Zapier, custom)
# GENERIC_WEBHOOK_URL=https://your-webhook-url.com/leadbot

# Min lead score to send to notifications (default 30)
NOTIFY_MIN_SCORE=30

# ----- EMAIL ENRICHMENT (optional, all have free tiers) -----
# ⚠️ Free tiers are SMALL (25-50 searches/month). Use on top leads only.
# If none set, the enricher falls back to free pattern guessing (hello@domain.com etc.)

# Hunter.io - 25 free searches/month - https://hunter.io/api-keys
# HUNTER_API_KEY=your_hunter_api_key

# Snov.io - 50 free credits/month - https://snov.io/api
# SNOV_CLIENT_ID=your_client_id
# SNOV_CLIENT_SECRET=your_client_secret

# Apollo.io - 10,000 free credits/month (BEST for finding people) - https://app.apollo.io/#/settings/integrations/api
# APOLLO_API_KEY=your_apollo_api_key
